# Set locally. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# MCP reviews are disabled until explicitly enabled (each review is billable).
H2O_MCP_ENABLE_REVIEWS=0
# Required for protected HTTP only; configure privately for approved deployment.
H2O_MCP_RESOURCE_URL=
H2O_MCP_OAUTH_ISSUER=
H2O_MCP_JWKS_URL=
